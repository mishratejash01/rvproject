# ── Client (Vite build-time) ────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# ── Server (Vercel functions only — never exposed to the client) ────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<supabase-secret-or-service-role-key>
GEMINI_API_KEY=<google-ai-studio-api-key>

# ── Local tooling only (not needed on Vercel) ───────────────────────
SUPABASE_ACCESS_TOKEN=<supabase-management-pat>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
